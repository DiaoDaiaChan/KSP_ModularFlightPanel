<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ModularFlightPanel</AssemblyName>
    <RootNamespace>ModularFlightPanel</RootNamespace>
    <OutputType>Library</OutputType>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KSPRoot Condition="'$(KSPRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program_newmod</KSPRoot>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DefineConstants>KSP_RUNTIME;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UI\Auditing\RoslynAstHelper.cs" />
    <Compile Remove="UI\Auditing\SemanticCompilationProvider.cs" />
    <Compile Remove="UI\Auditing\WidgetSourceAudit.cs" />
    <Compile Remove="UI\Auditing\WidgetModernizationAudit.cs" />
    <Compile Remove="UI\Auditing\WidgetColorLiteralAudit.cs" />
    <Compile Remove="UI\Auditing\WidgetFieldPenetrationAudit.cs" />
    <Compile Remove="UI\Auditing\I18nSyntaxAuditor.cs" />
    <Compile Remove="UI\Auditing\WidgetInternalLayoutAudit.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- KSP Core Assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Unity Engine Modules -->
    <Reference Include="UnityEngine">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.TextCoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony -->
    <Reference Include="0Harmony">
      <HintPath>$(KSPRoot)\GameData\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Optional ToolbarControl & ClickThroughBlocker -->
    <Reference Include="ToolbarControl" Condition="Exists('$(KSPRoot)\GameData\001_ToolbarControl\Plugins\ToolbarControl.dll')">
      <HintPath>$(KSPRoot)\GameData\001_ToolbarControl\Plugins\ToolbarControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ClickThroughBlocker" Condition="Exists('$(KSPRoot)\GameData\000_ClickThroughBlocker\Plugins\ClickThroughBlocker.dll')">
      <HintPath>$(KSPRoot)\GameData\000_ClickThroughBlocker\Plugins\ClickThroughBlocker.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Post-Build copy to local GameData and KSP installation -->
  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(SkipPostBuildCopy)' != 'true'">
    <ItemGroup>
      <OutputFiles Include="$(TargetPath)" />
      <OutputPdb Condition="Exists('$(TargetDir)$(TargetName).pdb')" Include="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <!-- Copy to repo GameData -->
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\GameData\ModularFlightPanel\Plugins\" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(OutputPdb)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\GameData\ModularFlightPanel\Plugins\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" SkipUnchangedFiles="true" ContinueOnError="true" />
    <!-- Copy directly to target KSP instance GameData -->
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(KSPRoot)\GameData\ModularFlightPanel\Plugins\" SkipUnchangedFiles="true" Condition="Exists('$(KSPRoot)\GameData')" ContinueOnError="true" Retries="0" />
    <Copy SourceFiles="@(OutputPdb)" DestinationFolder="$(KSPRoot)\GameData\ModularFlightPanel\Plugins\" Condition="Exists('$(TargetDir)$(TargetName).pdb') and Exists('$(KSPRoot)\GameData')" SkipUnchangedFiles="true" ContinueOnError="true" Retries="0" />
    
    <!-- Copy layout.json and themes to target KSP instance PluginData & Themes -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\GameData\ModularFlightPanel\PluginData\layout.json" DestinationFolder="$(KSPRoot)\GameData\ModularFlightPanel\PluginData\" Condition="Exists('$(MSBuildProjectDirectory)\..\..\GameData\ModularFlightPanel\PluginData\layout.json') and Exists('$(KSPRoot)\GameData')" SkipUnchangedFiles="false" ContinueOnError="true" />

    <!-- Copy Localization files to target KSP instance -->
    <ItemGroup>
      <LocalizationFiles Include="$(MSBuildProjectDirectory)\..\..\GameData\ModularFlightPanel\Localization\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="$(KSPRoot)\GameData\ModularFlightPanel\Localization\" Condition="Exists('$(KSPRoot)\GameData')" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!-- 编译期航电组件合规性与架构现代化进度提醒 (Compliance & Legacy Widget Audit Notice) -->
  <Target Name="AuditWidgetModernization" AfterTargets="CoreCompile" Condition="'$(SkipModernizationAudit)' != 'true'">
    <PropertyGroup>
      <ValidatorDll Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\HeadlessValidator\bin\Debug\net6.0\HeadlessValidator.dll')">$(MSBuildProjectDirectory)\..\..\tools\HeadlessValidator\bin\Debug\net6.0\HeadlessValidator.dll</ValidatorDll>
      <ValidatorDll Condition="'$(ValidatorDll)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\tools\HeadlessValidator\bin\Release\net6.0\HeadlessValidator.dll')">$(MSBuildProjectDirectory)\..\..\tools\HeadlessValidator\bin\Release\net6.0\HeadlessValidator.dll</ValidatorDll>
    </PropertyGroup>
    <Exec Condition="'$(ValidatorDll)' != ''"
          Command="dotnet &quot;$(ValidatorDll)&quot; --audit-legacy --msbuild"
          StandardOutputImportance="High"
          StandardErrorImportance="High"
          ContinueOnError="true" />
  </Target>

</Project>
