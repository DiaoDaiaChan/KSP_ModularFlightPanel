<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ModularFlightPanel.HeadlessValidator</RootNamespace>
    <KSPRoot Condition="'$(KSPRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program_newmod</KSPRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(KSPRoot)\KSP_x64_Data\Managed\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- MFP 组件规范审计内核：直接编译插件源码本体（纯 C#，无 UnityEngine 依赖），
         保证规则码 / 正则 / 扫描范围 / 颜色基线只有一份定义，杜绝验证器副本漂移。 -->
    <Compile Include="..\..\src\ModularFlightPanel\UI\Auditing\WidgetSourceAudit.cs" />
    <Compile Include="..\..\src\ModularFlightPanel\UI\Auditing\WidgetColorLiteralAudit.cs" />
    <Compile Include="..\..\src\ModularFlightPanel\Core\I18nJsonParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" />
  </ItemGroup>

</Project>
