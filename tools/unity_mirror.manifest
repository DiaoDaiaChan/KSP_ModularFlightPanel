# ==========================================================================================
# Unity 无头预览工程镜像清单 (unity/Assets/ModularFlightPanel)
# ==========================================================================================
# 语法（只有一条规则，避免"部分副本全靠人记"）：
#   · 每一行是一条【排除】模式，以 ! 开头；支持 * 通配（* = 不跨目录任意字符，** = 跨目录）。
#   · 未列出的 src/ModularFlightPanel/**.cs 一律【必须】出现在镜像里，且与源码逐字节一致。
#   · 反过来，镜像里出现了被排除的文件、或出现清单之外的 .cs，都算违规（多余文件）。
#
# 为什么有排除项：unity/ 是一个独立的 Unity 2019 工程，只用于无头 UI 渲染预览
#   (test-ui.ps1 -Render → Assets/Editor/HeadlessUIRenderer)。它不依赖 KSP 运行时，
#   因此凡是要靠 KSP 程序集/存档/Harmony/IMGUI 才能编译的源码都不能进镜像。
#
# 维护方式（禁止手工复制粘贴）：
#   python 不在链路上，唯一实现是验证器：
#     dotnet run --project tools/HeadlessValidator -- --mirror-check   # CI 门禁：缺失/漂移/多余均报错
#     dotnet run --project tools/HeadlessValidator -- --mirror-fix     # 按本清单同步镜像
# ==========================================================================================

# ── KSP 运行时胶水：插件启动、Harmony 补丁、原版姿态球挂钩、剪影烘焙 ──
!Core/Hooks/NavballPlugin.cs
!Core/Hooks/HarmonyPatches.cs
!Core/Hooks/StockNavBallHook.cs
!Core/Hooks/StockStageIconHook.cs
!Core/Hooks/MFPToolbarButton.cs
!Core/Hooks/DockAnchorTracker.cs
!Core/Rendering/VesselSilhouetteBaker.cs
!Core/Rendering/Vessel3DBaker.cs

# ── 遥测采集层：探针中枢 + 各 Mod 适配探针 + 反射遍历器（全部依赖 KSP 程序集与真实场景）──
!Core/Probes/*

# ── 遥测汇聚（依赖 Core/Probes 的探针结果）──
!Core/Telemetry/TelemetryHub.cs

# ── IMGUI 设置面板：KSP 游戏内配置界面，不参与 UI 预览渲染 ──
!UI/Settings/*

# ── 构建期审计工具链：只在插件编译期/无头 CI 使用，不进 Unity 工程 ──
!UI/Auditing/*
